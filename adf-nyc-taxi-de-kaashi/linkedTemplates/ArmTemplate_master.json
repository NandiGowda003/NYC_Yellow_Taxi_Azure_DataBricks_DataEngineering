{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-nyc-taxi-de-kaashi"
		},
		"LS_ADLS_NYC_Taxi_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_NYC_Taxi'"
		},
		"LS_AzureSQL_Control_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSQL_Control'"
		},
		"LS_ADLS_NYC_Taxi_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stnyctaxide2026nandi.dfs.core.windows.net/"
		},
		"LS_AzureSQL_Control_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "avinashcg.database.windows.net"
		},
		"LS_AzureSQL_Control_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-nyc-taxi-control"
		},
		"LS_AzureSQL_Control_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqllogin"
		},
		"LS_HTTP_Frankfurter_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://api.frankfurter.dev"
		},
		"LS_HTTP_NYC_TLC_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://d37ci6vzurychx.cloudfront.net"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-nyc-taxi-de-kaashi_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_NYC_Taxi_accountKey": {
						"value": "[parameters('LS_ADLS_NYC_Taxi_accountKey')]"
					},
					"LS_AzureSQL_Control_password": {
						"value": "[parameters('LS_AzureSQL_Control_password')]"
					},
					"LS_ADLS_NYC_Taxi_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_NYC_Taxi_properties_typeProperties_url')]"
					},
					"LS_AzureSQL_Control_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_Control_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_Control_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_Control_properties_typeProperties_database')]"
					},
					"LS_AzureSQL_Control_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSQL_Control_properties_typeProperties_userName')]"
					},
					"LS_HTTP_Frankfurter_properties_typeProperties_url": {
						"value": "[parameters('LS_HTTP_Frankfurter_properties_typeProperties_url')]"
					},
					"LS_HTTP_NYC_TLC_properties_typeProperties_url": {
						"value": "[parameters('LS_HTTP_NYC_TLC_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}